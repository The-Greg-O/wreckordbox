{
 "about": "Track Filter bar filters and what the window and the service are sent for each. src/lib/shellTrackFilter.test.ts checks the model produces exactly these forms; src-tauri/tests/track_filter_agrees.rs runs both forms against one fixture Library and checks they list exactly 'expected' (worked out from the fixture's definition, not from either implementation). categories: the Library's MyTag categories in the window's order. loaded: the track Key match and BPM ±6% follow. inPlaylist / inIntelligent: open the test's playlist or intelligent playlist instead of All Tracks. A case with no 'expected' (text) is checked for agreement only.",
 "categories": [
  "Situation",
  "Mood"
 ],
 "cases": [
  {
   "name": "the design's example: two Situation tags, Energy 3 to 5",
   "filter": {
    "myTags": [
     {
      "category": "Situation",
      "tags": [
       "Tension builder",
       "Peak time"
      ]
     }
    ],
    "energy": {
     "min": 3,
     "max": 5
    }
   },
   "expected": [
    10006,
    10018
   ],
   "window": {
    "query": "",
    "filter": {
     "ratings": [
      3,
      4,
      5
     ],
     "tags": [
      {
       "category": 0,
       "any": false,
       "tags": [
        "Tension builder",
        "Peak time"
       ]
      }
     ]
    }
   },
   "service": {
    "energies": [
     "3..5"
    ],
    "my_tag_picks": [
     {
      "category": "Situation",
      "tags": [
       "Tension builder",
       "Peak time"
      ],
      "any": false
     }
    ]
   }
  },
